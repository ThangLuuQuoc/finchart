export N_StrongSpinningTop(simple float _spinningTopBarMinWicks = 34, simple int _spinningTopBarEmaLength = 14) =>
    spread() < spread(1) and volume() > volume(1) and volume() > volume(2) and spinningTopBar(_spinningTopBarMinWicks, _spinningTopBarEmaLength)

// @function                        Determines if there is a neutral signal (Quiet High Wave).
// @param _highWaveBarMinBody       (float) The minimum body percentage for high wave bar. Default is 10 (represents 10%).
// @param _highWaveBarMinWick       (float) The minimum wick percentage for high wave bar. Default is 25 (represents 25%).
// @param _highWaveBarBars          (int) The number of bars for comparison. Default is 10.
// @returns                         (bool) True if there is a neutral signal (Quiet High Wave), otherwise false.
export N_QuietHighWave(simple float _highWaveBarMinBody = 10, simple float _highWaveBarMinWick = 25, simple int _highWaveBarBars = 10) =>
    spread() > spread(1) and volume() < volume(1) and volume() < volume(2) and highWaveBar(_highWaveBarMinBody, _highWaveBarMinWick, _highWaveBarBars)

// @function                        Determines if there is a neutral signal (Balanced High Wave).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _highWaveBarMinBody       (float) The minimum body percentage for high wave bar. Default is 10 (represents 10%).
// @param _highWaveBarMinWick       (float) The minimum wick percentage for high wave bar. Default is 25 (represents 25%).
// @param _highWaveBarBars          (int) The number of bars for comparison. Default is 10.
// @returns                         (bool) True if there is a neutral signal (Balanced High Wave), otherwise false.
export N_BalancedHighWave(map<string, float> _data, simple float _highWaveBarMinBody = 10, simple float _highWaveBarMinWick = 25, simple int _highWaveBarBars = 10) =>
    spread() > _data.get('SpreadLevelLow') and spread() < _data.get('SpreadLevelHigh') and volume() > _data.get('VolumeLevelLow') and volume() < _data.get('VolumeLevelHigh') and highWaveBar(_highWaveBarMinBody, _highWaveBarMinWick, _highWaveBarBars)

// @function                        Determines if there is a neutral signal (Strong High Wave).
// @param _highWaveBarMinBody       (float) The minimum body percentage for high wave bar. Default is 10 (represents 10%).
// @param _highWaveBarMinWick       (float) The minimum wick percentage for high wave bar. Default is 25 (represents 25%).
// @param _highWaveBarBars          (int) The number of bars for comparison. Default is 10 (represents 10%).
// @returns                         (bool) True if there is a neutral signal (Strong High Wave), otherwise false.
export N_StrongHighWave(simple float _highWaveBarMinBody = 10, simple float _highWaveBarMinWick = 25, simple int _highWaveBarBars = 10) =>
    spread() > spread(1) and volume() > volume(1) and volume() > volume(2) and highWaveBar(_highWaveBarMinBody, _highWaveBarMinWick, _highWaveBarBars)

// @function                        Determines if there is a neutral signal (Consolidation).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _consolidationBarSpread   (float) The spread percentage for consolidation bar. Default is 10 (represents 10%).
// @param _consolidationBarBars     (int) The number of bars for comparison. Default is 4.
// @returns                         (bool) True if there is a neutral signal (Consolidation), otherwise false.
export N_Consolidation(map<string, float> _data, simple float _consolidationBarSpread = 50, simple int _consolidationBarBars = 4) =>
    bool isLowVolume = true
    for i = 0 to _consolidationBarBars - 1
        isLowVolume := isLowVolume and (volume(i) < _data.get('VolumeLevelAverage'))
    isLowVolume and consolidationBar(_data, _consolidationBarSpread, _consolidationBarBars)
