//@version=5

// @description A library for Volume Spread Analysis (VSA).
library("VolumeSpreadAnalysis", true)

// @function                        Calculates the spread of a bar.
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (float) The spread of the bar.
export spread(int _barIndex = 0) => high[_barIndex] - low[_barIndex]

// @function                        Retrieves the volume of a bar.
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (float) The volume of the bar.
export volume(int _barIndex = 0) => volume[_barIndex]

// @function                        Calculates the body of a bar.
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (float) The body size of the bar.
export body(simple int _barIndex = 0) => math.abs(close[_barIndex] - open[_barIndex])

// @function                        Calculates the upper wick of a bar (upper shadow).
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (float) The upper wick size of the bar.
export wickUpper(simple int _barIndex = 0) => high[_barIndex] - math.max(open[_barIndex], close[_barIndex])

// @function                        Calculates the lower wick of a bar (lower shadow).
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (float) The lower wick size of the bar.
export wickLower(simple int _barIndex = 0) => math.min(open[_barIndex], close[_barIndex]) - low[_barIndex]

// @function                        Calculates the forecasted Simple Moving Average (SMA).
// @param _source                   (series float) Source data for calculation.
// @param _length                   (int) The length of the SMA.
// @param _forecastedLevel          (float) The forecasted level to include in the calculation.
// @returns                         (float) The forecasted SMA value.
export calcForecastedSMA(series float _source, simple int _length, series float _forecastedLevel) =>
    float sum = 0.0
    for i = 1 to _length - 1
        sum += (_source[i] / _length)
    float forecasted = sum + _forecastedLevel / _length
    float og = sum + _source / _length
    forecasted

// @function                        Calculates the forecasted Exponential Moving Average (EMA).
// @param _source                   (series float) Source data for calculation.
// @param _length                   (int) The length of the EMA.
// @param _forecastedLevel          (float) The forecasted level to include in the calculation.
// @returns                         (float) The forecasted EMA value.
export calcForecastedEMA(series float _source, simple int _length, series float _forecastedLevel) =>
    float alpha = 2 / (_length + 1)
    float og = 0.0
    forecasted = na(og[1]) ? _forecastedLevel : alpha * _forecastedLevel + (1 - alpha) * nz(og[1]) //Forecasted Result
    og := na(og[1]) ? _source : alpha * _source + (1 - alpha) * nz(og[1]) //Original result
    forecasted

// @function                        Calculates the forecasted Relative Moving Average (RMA).
// @param _source                   (series float) Source data for calculation.
// @param _length                   (int) The length of the RMA.
// @param _forecastedLevel          (float) The forecasted level to include in the calculation.
// @returns                         (float) The forecasted RMA value.
export calcForecastedRMA(series float _source, simple int _length, series float _forecastedLevel) =>
    float sumSMA = 0.0
    for i = 1 to _length - 1
        sumSMA := sumSMA + (_source[i] / _length)
    float forecasted1 = sumSMA + _forecastedLevel / _length
    og1 = sumSMA + _source / _length
    alpha = 1/_length
    forecasted = 0.0
    og = 0.0
    forecasted := na(og[1]) ? forecasted1 : alpha * _forecastedLevel + (1 - alpha) * nz(og[1]) //Forecasted Result
    og := na(og[1]) ? og1 : alpha * _source  + (1 - alpha) * nz(og[1]) //Original result
    forecasted

// @function                        Calculates the forecasted Weighted Moving Average (WMA).
// @param _source                   (series float) Source data for calculation.
// @param _length                   (int) The length of the WMA.
// @param _forecastedLevel          (float) The forecasted level to include in the calculation.
// @returns                         (float) The forecasted WMA value.
export calcForecastedWMA(series float _source, simple int _length, series float _forecastedLevel) =>
    float norm = 0.0
    float sum = 0.0
    for i = 1 to _length - 1
        float _weight = (_length - i) * _length
        norm += _weight
        sum += _source[i] * _weight
    float forecasted = (sum + (_forecastedLevel * _length * _length)) / (norm + (_length * _length)) //Forecasted Result
    float og = (sum + (_source * _length * _length)) / (norm + (_length * _length)) //Original Result
    forecasted

// @function                        Calculates the elapsed time percent of the current bar.
// @returns                         (float) The elapsed time percent.
export calcElapsedTimePercent() =>
    elapsedTimePercent = (timenow - time) / (time_close - time) // (UTC Time now - UTC Time at open) / (UTC Time at close - UTC Time at open)
    // elapsedTimePercent = (timenow - time(timeframe.period)) / (timeframe.in_seconds(timeframe.period) * 1000)  //Alernate method which assumes price updates for entire timeframe duration (doesn't handle scenarios where chart's timeframe is larger than bar's duration)
    math.min(elapsedTimePercent,1)

// @function                        Calculates the forecasted spread using elapsed time and dynamic multipliers, handling spread's non-linear nature.
// @param multiplierAtMidpoints     (float) The multiplier value at midpoints. Default is 0.5.
// @param multiplierAtPeaks         (float) The multiplier value at peaks. Default is 0.7.
// @returns                         (float) The forecasted spread value.
export calcForecastedSpread(float multiplierAtMidpoints = 0.5, float multiplierAtPeaks = 0.7) =>
    elapsedTimePercent = calcElapsedTimePercent() // Percent = ElapsedTime / TimeframeTime
    midPoint = (high + low) / 2 //Calculate the midpoint
    totalRange = high - low //Calculate the total range
    dynamicMultiplier = multiplierAtMidpoints + (multiplierAtPeaks - multiplierAtMidpoints) * (math.abs(close - midPoint) / (totalRange / 2)) // Dynamic Multiplier
    elapsedTimeSpread = (1 - ((1 - elapsedTimePercent) * dynamicMultiplier)) // Get a "percent time remaining" for spread, by applying dynamic multiplier to actual bar percent time remaining
    distanceToPeak = math.min(high - close, close - low) // Distance to nearest peak to exclude it from the forecasted spread
    predictedLevelSpread = elapsedTimePercent > 0 ? math.max((spread() / elapsedTimeSpread) - distanceToPeak, spread()) : na //Calculate forecasted spread
    predictedLevelSpread

// @function                        Calculates the forecasted volume using elapsed time, satisfying volume's linear nature.
// @returns                         (float) The forecasted volume value.
export calcForecastedVolume() =>
    elapsedTimePercent = calcElapsedTimePercent() //Percent = ElapsedTime / TimeframeTime
    predictedLevelVolume = elapsedTimePercent > 0 ? volume() / elapsedTimePercent : na //Calculate forecasted volume
    predictedLevelVolume

// @function                        Calculates the forecasted Moving Average (MA) based on the specified type.
// @param _source                   (series float) Source data for calculation.
// @param _length                   (int) The length of the MA.
// @param _forecastedSource         (float) The forecasted level to include in the calculation.
// @param _type                     (string) The type of the MA ("SMA", "EMA", "SMMA (RMA)", "WMA").
// @returns                         (float) The forecasted MA value.
export calcForecastedMA(series float _source, simple int _length, series float _forecastedSource, simple string _type) =>
    switch _type
        "SMA" => calcForecastedSMA(_source, _length, _forecastedSource)
        "EMA" => calcForecastedEMA(_source, _length, _forecastedSource)
        "SMMA (RMA)" => calcForecastedRMA(_source, _length, _forecastedSource)
        "WMA" => calcForecastedWMA(_source, _length, _forecastedSource)

// @function                        Calculates the Moving Average (MA) based on the specified type.
// @param _source                   (series float) Source data for calculation.
// @param _length                   (int) The length of the MA.
// @param _type                     (string) The type of the MA ("SMA", "EMA", "SMMA (RMA)", "WMA").
// @returns                         (float) The MA value.
export calcMA(series float _source, simple int _length, simple string _type) =>
    switch _type
        "SMA" => ta.sma(_source, _length)
        "EMA" => ta.ema(_source, _length)
        "SMMA (RMA)" => ta.rma(_source, _length)
        "WMA" => ta.wma(_source, _length)

// @function                        Determines if the bar is bullish.
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (bool) True if the bar is bullish, otherwise false.
export bullBar(simple int _barIndex = 0) => close[_barIndex] > open[_barIndex]

// @function                        Determines if the bar is bearish.
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (bool) True if the bar is bearish, otherwise false.
export bearBar(simple int _barIndex = 0) => close[_barIndex] < open[_barIndex]

// @function                        Determines if there is a breakout above the previous bar.
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (bool) True if there is a breakout, otherwise false.
export breakout(simple int _barIndex = 0) => close[_barIndex] > high[_barIndex + 1]

// @function                        Determines if there is a breakdown below the previous bar.
// @param _barIndex                 (int) The index of the bar. Default is 0.
// @returns                         (bool) True if there is a breakdown, otherwise false.
export breakdown(simple int _barIndex = 0) => close[_barIndex] < low[_barIndex + 1]

// @function                        Determines if the upper wick is a rejection wick.
// @param _rejectionWick            (float) The rejection wick percentage. Default is 25 (represents 25%).
// @returns                         (bool) True if the upper wick is a rejection wick, otherwise false.
export rejectionWickUpper(simple float _rejectionWick = 25) => (high - close) / spread() > _rejectionWick / 100

// @function                        Determines if the lower wick is a rejection wick.
// @param _rejectionWick            (float) The rejection wick percentage. Default is 25. (represents 25%)
// @returns                         (bool) True if the lower wick is a rejection wick, otherwise false.
export rejectionWickLower(simple float _rejectionWick = 25) => (close - low) / spread() > _rejectionWick / 100

// @function                        Sets up data for volume levels.
// @param _data                     (map<string, float>) The map to store the levels.
// @param _mult_Low                 (float) The multiplier for low level. Default is 0.5.
// @param _mult_High                (float) The multiplier for high level. Default is 1.5.
// @param _mult_Ultra               (float) The multiplier for ultra level. Default is 3.0.
// @param _maLengthVolume           (int) The length for MA. Default is 20.
// @param _maTypeVolume             (string) The type for MA. Default is SMA.
// @returns                         (void) Nothing.
export setupDataVolume(map<string, float> _data, simple float _mult_Low = 0.5, simple float _mult_High = 1.5, simple float _mult_Ultra = 3.0, simple int _maLengthVolume = 20, simple string _maTypeVolume = 'SMA') =>
    float _VolumeLevelAverage = calcMA(volume(), _maLengthVolume, _maTypeVolume)
    _data.put('VolumeLevel', volume()) //Reference map to ensure other functions represent volume instead of forecast volume
    _data.put('VolumeLevelAverage', _VolumeLevelAverage)
    _data.put('VolumeLevelLow', _VolumeLevelAverage * _mult_Low)
    _data.put('VolumeLevelHigh', _VolumeLevelAverage * _mult_High)
    _data.put('VolumeLevelUltra', _VolumeLevelAverage * _mult_Ultra)

// @function                        Sets up data for spread levels.
// @param _data                     (map<string, float>) The map to store the levels.
// @param _mult_Low                 (float) The multiplier for low level. Default is 0.5.
// @param _mult_High                (float) The multiplier for high level. Default is 1.5.
// @param _mult_Ultra               (float) The multiplier for ultra level. Default is 3.0.
// @param _maLengthSpread           (int) The length for MA. Default is 5.
// @param _maTypeSpread             (string) The type for MA. Default is SMA.
// @returns                         (void) Nothing.
export setupDataSpread(map<string, float> _data, simple float _mult_Low = 0.5, simple float _mult_High = 1.5, simple float _mult_Ultra = 3.0, simple int _maLengthSpread = 5, simple string _maTypeSpread = 'SMA') =>
    float _SpreadLevelAverage = calcMA(spread(), _maLengthSpread, _maTypeSpread)
    _data.put('SpreadLevel', spread()) //Reference map to ensure other functions represent spread instead of forecast spread
    _data.put('SpreadLevelAverage', _SpreadLevelAverage)
    _data.put('SpreadLevelLow', _SpreadLevelAverage * _mult_Low)
    _data.put('SpreadLevelHigh', _SpreadLevelAverage * _mult_High)
    _data.put('SpreadLevelUltra', _SpreadLevelAverage * _mult_Ultra)

// @function                        Sets up data for volume levels for forecast.
// @param _data                     (map<string, float>) The map to store the levels.
// @param _predictedLevelVolume     (float) The predicted level for MA.
// @param _mult_Low                 (float) The multiplier for low level. Default is 0.5.
// @param _mult_High                (float) The multiplier for high level. Default is 1.5.
// @param _mult_Ultra               (float) The multiplier for ultra level. Default is 3.0.
// @param _maLengthVolume           (int) The length for MA. Default is 0. Default is 20.
// @param _maTypeVolume             (string) The type for MA. Default is 0. Default is SMA.
// @returns                         (void) Nothing.
export setupDataForecastVolume(map<string, float> _dataForecast, series float _predictedLevelVolume, simple float _mult_Low = 0.5, simple float _mult_High = 1.5, simple float _mult_Ultra = 3.0, simple int _maLengthVolume = 20, simple string _maTypeVolume = 'SMA') =>
    float _VolumeLevelAverage = calcForecastedMA(volume(), _maLengthVolume, _predictedLevelVolume, _maTypeVolume)
    _dataForecast.put('VolumeLevel', _predictedLevelVolume) //Reference map to ensure other functions represent forecast volume instead of volume
    _dataForecast.put('VolumeLevelAverage', _VolumeLevelAverage)
    _dataForecast.put('VolumeLevelLow', _VolumeLevelAverage * _mult_Low)
    _dataForecast.put('VolumeLevelHigh', _VolumeLevelAverage * _mult_High)
    _dataForecast.put('VolumeLevelUltra', _VolumeLevelAverage * _mult_Ultra)

// @function                        Sets up data for spread levels for forecast.
// @param _data                     (map<string, float>) The map to store the levels.
// @param _predictedLevelSpread     (float) The predicted level for MA.
// @param _mult_Low                 (float) The multiplier for low level. Default is 0.5.
// @param _mult_High                (float) The multiplier for high level. Default is 1.5.
// @param _mult_Ultra               (float) The multiplier for ultra level. Default is 3.0.
// @param _maLengthSpread           (int) The length for MA. Default is 5.
// @param _maTypeSpread             (string) The type for MA. Default is SMA.
// @returns                         (void) Nothing.
export setupDataForecastSpread(map<string, float> _dataForecast, series float _predictedLevelSpread, simple float _mult_Low = 0.5, simple float _mult_High = 1.5, simple float _mult_Ultra = 3.0, simple int _maLengthSpread = 5, simple string _maTypeSpread = 'SMA') =>
    float _SpreadLevelAverage = calcForecastedMA(spread(), _maLengthSpread, _predictedLevelSpread, _maTypeSpread)
    _dataForecast.put('SpreadLevel', _predictedLevelSpread) //Reference map to ensure other functions represent forecast spread instead of spread
    _dataForecast.put('SpreadLevelAverage', _SpreadLevelAverage)
    _dataForecast.put('SpreadLevelLow', _SpreadLevelAverage * _mult_Low)
    _dataForecast.put('SpreadLevelHigh', _SpreadLevelAverage * _mult_High)
    _dataForecast.put('SpreadLevelUltra', _SpreadLevelAverage * _mult_Ultra)

// @function                        Determines if the volume is low.
// @param _data                     (map<string, float>) The data map with volume levels.
// @returns                         (bool) True if the volume is low, otherwise false.
export isVolumeLow(map<string, float> _data) => _data.get('VolumeLevel') < _data.get('VolumeLevelLow')

// @function                        Determines if the volume is normal.
// @param _data                     (map<string, float>) The data map with volume levels.
// @returns                         (bool) True if the volume is normal, otherwise false.
export isVolumeNormal(map<string, float> _data) => _data.get('VolumeLevel') > _data.get('VolumeLevelLow') and _data.get('VolumeLevel') < _data.get('VolumeLevelHigh')

// @function                        Determines if the volume is high.
// @param _data                     (map<string, float>) The data map with volume levels.
// @returns                         (bool) True if the volume is high, otherwise false.
export isVolumeHigh(map<string, float> _data) => _data.get('VolumeLevel') < _data.get('VolumeLevelUltra') and _data.get('VolumeLevel') > _data.get('VolumeLevelHigh')

// @function                        Determines if the volume is ultra.
// @param _data                     (map<string, float>) The data map with volume levels.
// @returns                         (bool) True if the volume is ultra, otherwise false.
export isVolumeUltra(map<string, float> _data) => _data.get('VolumeLevel') > _data.get('VolumeLevelUltra')

// @function                        Determines if the spread is low.
// @param _data                     (map<string, float>) The data map with spread levels.
// @returns                         (bool) True if the spread is low, otherwise false.
export isSpreadLow(map<string, float> _data) => _data.get('SpreadLevel') < _data.get('SpreadLevelLow')

// @function                        Determines if the spread is normal.
// @param _data                     (map<string, float>) The data map with spread levels.
// @returns                         (bool) True if the spread is normal, otherwise false.
export isSpreadNormal(map<string, float> _data) => _data.get('SpreadLevel') > _data.get('SpreadLevelLow') and _data.get('SpreadLevel') < _data.get('SpreadLevelHigh')

// @function                        Determines if the spread is high.
// @param _data                     (map<string, float>) The data map with spread levels.
// @returns                         (bool) True if the spread is high, otherwise false.
export isSpreadHigh(map<string, float> _data) => _data.get('SpreadLevel') < _data.get('SpreadLevelUltra') and _data.get('SpreadLevel') > _data.get('SpreadLevelHigh')

// @function                        Determines if the spread is ultra.
// @param _data                     (map<string, float>) The data map with spread levels.
// @returns                         (bool) True if the spread is ultra, otherwise false.
export isSpreadUltra(map<string, float> _data) => _data.get('SpreadLevel') > _data.get('SpreadLevelUltra')

// @function                        Determines text string representing the volume area level.
// @param _data                     (map<string, float>) The data map with volume levels.
// @returns                         (string) Text string of Low, Normal, High, or Ultra.
export isVolumeText(map<string, float> _data) =>
    isVolumeNormal(_data) ? 'Normal' :
     isVolumeLow(_data)   ? 'Low'    : 
     isVolumeHigh(_data)  ? 'High'   : 
     isVolumeUltra(_data) ? 'Ultra'  : 
     ''

// @function                        Determines text string representing the spread area level.
// @param _data                     (map<string, float>) The data map with spread levels.
// @returns                         (string) Text string of Low, Normal, High, or Ultra.
export isSpreadText(map<string, float> _data) =>
    isSpreadNormal(_data) ? 'Normal' :
     isSpreadLow(_data)   ? 'Low'    : 
     isSpreadHigh(_data)  ? 'High'   : 
     isSpreadUltra(_data) ? 'Ultra'  : 
     ''

// @function                        Calculates the color based level.
// @param _value                    (float) The value to check.
// @param _level                    (float) The value level for comparison.
// @returns                         (color) The color for the bar.
export calcBarColor(float _value, float _level) => _value > _level ? color.red : color.green

// @function                        Determines if the bar is a bull pin bar.
// @param _maxBodyPercent           (float) The maximum body percentage. Default is 33 (represents 33%).
// @param _minWickPercent           (float) The minimum wick percentage. Default is 60 (represents 60%).
// @returns                         (bool) True if the bar is a bull pin bar, otherwise false.
export bullPinBar(simple float _maxBodyPercent = 33, simple float _minWickPercent = 60) =>
    (body() / spread()) < (_maxBodyPercent / 100) and (math.abs(low - open) / spread()) > (_minWickPercent / 100) and (math.abs(low - close) / spread()) > (_minWickPercent / 100)

// @function                        Determines if the bar is a bear pin bar.
// @param _maxBodyPercent           (float) The maximum body percentage. Default is 33 (represents 33%).
// @param _minWickPercent           (float) The minimum wick percentage. Default is 60 (represents 60%).
// @returns                         (bool) True if the bar is a bear pin bar, otherwise false.
export bearPinBar(simple float _maxBodyPercent = 33, simple float _minWickPercent = 60) =>
    (body() / spread()) < (_maxBodyPercent / 100) and (high - open) / spread() > (_minWickPercent / 100) and (high - close) / spread() > (_minWickPercent / 100)

// @function                        Determines if the bar is a doji.
// @param _maxBodyPercent           (float) The maximum body percentage. Default is 10 (represents 10%).
// @returns                         (bool) True if the bar is a doji, otherwise false.
export dojiBar(simple float _maxBodyPercent = 10) =>
    bool isDoji = (spread() > 0) and (body() <= spread() * (_maxBodyPercent / 100))
    float upperShadow = wickUpper()
    float lowerShadow = wickLower()
    bool balancedShadows = (upperShadow / lowerShadow >= 0.5 and upperShadow / lowerShadow <= 2) or (lowerShadow / upperShadow >= 0.5 and lowerShadow / upperShadow <= 2)
    isDoji and balancedShadows

// @function                        Determines if the bar is a spinning top.
// @param _minWicksPercent          (float) The minimum wicks percentage. Default is 34 (represents 34%).
// @param _emaLength                (int) The length for EMA calculation. Default is 14.
// @returns                         (bool) True if the bar is a spinning top, otherwise false.
export spinningTopBar(simple float _minWicksPercent = 34, simple int _emaLength = 14) =>
    float bodyHigh = math.max(close, open)
    float bodyLow = math.min(close, open)
    float C_Body = bodyHigh - bodyLow
    float bodyAvg = ta.ema(C_Body, _emaLength)
    float upShadow = high - bodyHigh
    float downShadow = bodyLow - low
    bool smallBody = C_Body < bodyAvg
    bool hasLongShadows = upShadow >= spread() / 100 * _minWicksPercent and downShadow >= spread() / 100 * _minWicksPercent
    smallBody and hasLongShadows

// @function                        Determines if the bar is a high wave bar.
// @param _minBodyPercent           (float) The minimum body percentage. Default is 10 (represents 10%).
// @param _minWickPercent           (float) The minimum wick percentage. Default is 25 (represents 25%).
// @param _bars                     (int) The number of bars for comparison. Default is 10.
// @returns                         (bool) True if the bar is a high wave bar, otherwise false.
export highWaveBar(simple float _minBodyPercent = 10, simple float _minWickPercent = 25, simple int _bars = 10) =>
    float upperWickSize = wickUpper()
    float lowerWickSize = wickLower()
    bool bodyIsSmall = (body() / spread()) * 100 <= _minBodyPercent
    bool wicksAreLong = (upperWickSize / spread()) * 100 >= _minWickPercent and (lowerWickSize / spread()) * 100 >= _minWickPercent
    bool largerThanPrevious = ta.highest(spread(), _bars + 1)[1] < spread()
    bodyIsSmall and wicksAreLong and largerThanPrevious

// @function                        Determines if the bars are in consolidation.
// @param _data                     (map<string, float>) The data map with spread levels.
// @param _spread                   (float) The spread percentage for comparison. Default is 50.
// @param _bars                     (int) The number of bars for comparison. Default is 4.
// @returns                         (bool) True if the bars are in consolidation, otherwise false.
export consolidationBar(map<string, float> _data, simple float _spread = 50, simple int _bars = 4) =>
    bool isNarrowSpread = true
    bool isSmallBodies = true
    for i = 0 to _bars - 1
        isNarrowSpread := isNarrowSpread and (high[i] - low[i] < _data.get('SpreadLevelAverage'))
        isSmallBodies := isSmallBodies and (math.abs(close[i] - open[i]) < _data.get('SpreadLevelAverage') / (_spread / 100))
    isNarrowSpread and isSmallBodies

// @function                        Determines if there is a sign of strength (DownThrust).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _bullPinBarMaxBody        (float) The maximum body percentage for bull pin bar. Default is 33 (represents 33%).
// @param _bullPinBarMinWick        (float) The minimum wick percentage for bull pin bar. Default is 60 (represents 60%).
// @returns                         (bool) True if there is a sign of strength (DownThrust), otherwise false.
export S_DownThrust(map<string, float> _data, simple float _bullPinBarMaxBody = 33, simple float _bullPinBarMinWick = 60) =>
    spread() < _data.get('SpreadLevelAverage') and volume() > _data.get('VolumeLevelHigh') and bullPinBar(_bullPinBarMaxBody, _bullPinBarMinWick)

// @function                        Determines if there is a sign of strength (Selling Climax).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _rejectionWick            (float) The rejection wick percentage. Default is 25 (represents 25%).
// @returns                         (bool) True if there is a sign of strength (Selling Climax), otherwise false.
export S_SellingClimax(map<string, float> _data, simple float _rejectionWick = 25) =>
    spread() > _data.get('SpreadLevelAverage') and volume() > _data.get('VolumeLevelHigh') and bearBar() and rejectionWickLower(_rejectionWick)

// @function                        Determines if there is a sign of strength (No Effort Bearish Result).
// @returns                         (bool) True if there is a sign of strength (No Effort Bearish Result), otherwise false.
export S_NoEffortBearishResult() =>
    spread() > spread(1) and volume() < volume(1) and bearBar() and bearBar(1)

// @function                        Determines if there is a sign of strength (Bearish Effort No Result).
// @returns                         (bool) True if there is a sign of strength (Bearish Effort No Result), otherwise false.
export S_BearishEffortNoResult() =>
    spread() < spread(1) and volume() > volume(1) and bearBar() and bearBar(1)

// @function                        Determines if there is a sign of strength (Inverse DownThrust).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _bearPinBarMaxBody        (float) The maximum body percentage for bear pin bar.
// @param _bearPinBarMinWick        (float) The minimum wick percentage for bear pin bar.
// @returns                         (bool) True if there is a sign of strength (Inverse DownThrust), otherwise false.
export S_InverseDownThrust(map<string, float> _data, simple float _bearPinBarMaxBody = 33, simple float _bearPinBarMinWick = 60) =>
    spread() < spread(1) and volume() > _data.get('VolumeLevelAverage') and bearPinBar(_bearPinBarMaxBody, _bearPinBarMinWick)

// @function                        Determines if there is a sign of strength (Failed Selling Climax).
// @returns                         (bool) True if there is a sign of strength (Failed Selling Climax), otherwise false.
export S_FailedSellingClimax() =>
    spread(1) > spread(2) and volume(1) > volume(2) and bullBar() and bearBar(1) and bearBar(2)

// @function                        Determines if there is a sign of strength (Bull Outside Reversal).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @returns                         (bool) True if there is a sign of strength (Bull Outside Reversal), otherwise false.
export S_BullOutsideReversal(map<string, float> _data) =>
    breakout() and volume() > _data.get('VolumeLevelHigh') and low < low[1] and bullBar() and bearBar(1)

// @function                        Determines if there is a sign of strength (End of Falling Market).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @returns                         (bool) True if there is a sign of strength (End of Falling Market), otherwise false.
export S_EndOfFallingMarket(map<string, float> _data) =>
    spread() < _data.get('SpreadLevelAverage') and volume() > _data.get('VolumeLevelUltra') and bearBar()

// @function                        Determines if there is a sign of strength (Pseudo DownThrust).
// @param _bullPinBarMaxBody        (float) The maximum body percentage for bull pin bar. Default is 33 (represents 33%).
// @param _bullPinBarMinWick        (float) The minimum wick percentage for bull pin bar. Default is 60 (represents 60%).
// @returns                         (bool) True if there is a sign of strength (Pseudo DownThrust), otherwise false.
export S_PseudoDownThrust(simple float _bullPinBarMaxBody = 33, simple float _bullPinBarMinWick = 60) =>
    spread() < spread(1) and volume() < volume(1) and volume() < volume(2) and bullPinBar(_bullPinBarMaxBody, _bullPinBarMinWick)

// @function                        Determines if there is a sign of strength (No Supply).
// @param _bullPinBarMaxBody        (float) The maximum body percentage for bull pin bar. Default is 33 (represents 33%).
// @param _bullPinBarMinWick        (float) The minimum wick percentage for bull pin bar. Default is 60 (represents %).
// @returns                         (bool) True if there is a sign of strength (No Supply), otherwise false.
export S_NoSupply(simple float _bullPinBarMaxBody = 33, simple float _bullPinBarMinWick = 60) =>
    spread() < spread(1) and spread() < spread(2) and volume() < volume(1) and volume() < volume(2) and bullPinBar(_bullPinBarMaxBody, _bullPinBarMinWick)

// @function                        Determines if there is a sign of weakness (UpThrust).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _bearPinBarMaxBody        (float) The maximum body percentage for bear pin bar. Default is 33 (represents 33%).
// @param _bearPinBarMinWick        (float) The minimum wick percentage for bear pin bar. Default is 60 (represents 60%).
// @returns                         (bool) True if there is a sign of weakness (UpThrust), otherwise false.
export W_UpThrust(map<string, float> _data, simple float _bearPinBarMaxBody = 33, simple float _bearPinBarMinWick = 60) =>
    spread() < _data.get('SpreadLevelAverage') and volume() > _data.get('VolumeLevelHigh') and bearPinBar(_bearPinBarMaxBody, _bearPinBarMinWick)

// @function                        Determines if there is a sign of weakness (Buying Climax).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _rejectionWick            (float) The rejection wick percentage. Default is 25 (represents 25%).
// @returns                         (bool) True if there is a sign of weakness (Buying Climax), otherwise false.
export W_BuyingClimax(map<string, float> _data, simple float _rejectionWick = 25) =>
    spread() > _data.get('SpreadLevelAverage') and volume() > _data.get('VolumeLevelHigh') and bullBar() and rejectionWickUpper(_rejectionWick)

// @function                        Determines if there is a sign of weakness (No Effort Bullish Result).
// @returns                         (bool) True if there is a sign of weakness (No Effort Bullish Result), otherwise false.
export W_NoEffortBullishResult() =>
    spread() > spread(1) and volume() < volume(1) and bullBar() and bullBar(1)

// @function                        Determines if there is a sign of weakness (Bullish Effort No Result).
// @returns                         (bool) True if there is a sign of weakness (Bullish Effort No Result), otherwise false.
export W_BullishEffortNoResult() =>
    spread() < spread(1) and volume() > volume(1) and bullBar() and bullBar(1)

// @function                        Determines if there is a sign of weakness (Inverse UpThrust).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _bullPinBarMaxBody        (float) The maximum body percentage for bull pin bar. Default is 33 (represents 33%).
// @param _bullPinBarMinWick        (float) The minimum wick percentage for bull pin bar. Default is 60 (represents 60%).
// @returns                         (bool) True if there is a sign of weakness (Inverse UpThrust), otherwise false.
export W_InverseUpThrust(map<string, float> _data, simple float _bullPinBarMaxBody = 33, simple float _bullPinBarMinWick = 60) =>
    spread() < spread(1) and volume() > _data.get('VolumeLevelAverage') and bullPinBar(_bullPinBarMaxBody, _bullPinBarMinWick)

// @function                        Determines if there is a sign of weakness (Failed Buying Climax).
// @returns                         (bool) True if there is a sign of weakness (Failed Buying Climax), otherwise false.
export W_FailedBuyingClimax() =>
    spread(1) > spread(2) and volume(1) > volume(2) and bearBar() and bullBar(1) and bullBar(2)

// @function                        Determines if there is a sign of weakness (Bear Outside Reversal).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @returns                         (bool) True if there is a sign of weakness (Bear Outside Reversal), otherwise false.
export W_BearOutsideReversal(map<string, float> _data) =>
    breakdown() and volume() > _data.get('VolumeLevelHigh') and high > high[1] and bearBar() and bullBar(1)

// @function                        Determines if there is a sign of weakness (End of Rising Market).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @returns                         (bool) True if there is a sign of weakness (End of Rising Market), otherwise false.
export W_EndOfRisingMarket(map<string, float> _data) =>
    spread() < _data.get('SpreadLevelAverage') and volume() > _data.get('VolumeLevelUltra') and bullBar()

// @function                        Determines if there is a sign of weakness (Pseudo UpThrust).
// @param _bearPinBarMaxBody        (float) The maximum body percentage for bear pin bar. Default is 33 (represents 33%).
// @param _bearPinBarMinWick        (float) The minimum wick percentage for bear pin bar. Default is 60 (represents 60%).
// @returns                         (bool) True if there is a sign of weakness (Pseudo UpThrust), otherwise false.
export W_PseudoUpThrust(simple float _bearPinBarMaxBody = 33, simple float _bearPinBarMinWick = 60) =>
    spread() < spread(1) and volume() < volume(1) and volume() < volume(2) and bearPinBar(_bearPinBarMaxBody, _bearPinBarMinWick)

// @function                        Determines if there is a sign of weakness (No Demand).
// @param _bearPinBarMaxBody        (float) The maximum body percentage for bear pin bar. Default is 33 (represents 33%).
// @param _bearPinBarMinWick        (float) The minimum wick percentage for bear pin bar. Default is 60 (represents 60%).
// @returns                         (bool) True if there is a sign of weakness (No Demand), otherwise false.
export W_NoDemand(simple float _bearPinBarMaxBody = 33, simple float _bearPinBarMinWick = 60) =>
    spread() < spread(1) and spread() < spread(2) and volume() < volume(1) and volume() < volume(2) and bearPinBar(_bearPinBarMaxBody, _bearPinBarMinWick)

// Functions for Neutral
// @function                        Determines if there is a neutral signal (Quiet Doji).
// @param _dojiBarMaxBody           (float) The maximum body percentage for doji bar. Default is 10 (represents 10%).
// @returns                         (bool) True if there is a neutral signal (Quiet Doji), otherwise false.
export N_QuietDoji(simple float _dojiBarMaxBody = 10) =>
    spread() < spread(1) and volume() < volume(1) and volume() < volume(2) and dojiBar(_dojiBarMaxBody)

// @function                        Determines if there is a neutral signal (Balanced Doji).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _dojiBarMaxBody           (float) The maximum body percentage for doji bar. Default is 10 (represents 10%).
// @returns                         (bool) True if there is a neutral signal (Balanced Doji), otherwise false.
export N_BalancedDoji(map<string, float> _data, simple float _dojiBarMaxBody = 10) =>
    spread() > _data.get('SpreadLevelLow') and spread() < _data.get('SpreadLevelHigh') and volume() > _data.get('VolumeLevelLow') and volume() < _data.get('VolumeLevelHigh') and dojiBar(_dojiBarMaxBody)

// @function                        Determines if there is a neutral signal (Strong Doji).
// @param _dojiBarMaxBody           (float) The maximum body percentage for doji bar. Default is 10 (represents 10%).
// @returns                         (bool) True if there is a neutral signal (Strong Doji), otherwise false.
export N_StrongDoji(simple float _dojiBarMaxBody = 10) =>
    spread() < spread(1) and volume() > volume(1) and volume() > volume(2) and dojiBar(_dojiBarMaxBody)

// @function                        Determines if there is a neutral signal (Quiet Spinning Top).
// @param _spinningTopBarMinWicks   (float) The minimum wicks percentage for spinning top bar. Default is 34 (represents 34%).
// @param _spinningTopBarEmaLength  (int) The length for EMA calculation. Default is 14.
// @returns                         (bool) True if there is a neutral signal (Quiet Spinning Top), otherwise false.
export N_QuietSpinningTop(simple float _spinningTopBarMinWicks = 34, simple int _spinningTopBarEmaLength = 14) =>
    spread() < spread(1) and volume() < volume(1) and volume() < volume(2) and spinningTopBar(_spinningTopBarMinWicks, _spinningTopBarEmaLength)

// @function                        Determines if there is a neutral signal (Balanced Spinning Top).
// @param _data                     (map<string, float>) The data map with volume and spread levels.
// @param _spinningTopBarMinWicks   (float) The minimum wicks percentage for spinning top bar. Default is 34 (represents 34%).
// @param _spinningTopBarEmaLength  (int) The length for EMA calculation. Default is 14.
// @returns                         (bool) True if there is a neutral signal (Balanced Spinning Top), otherwise false.
export N_BalancedSpinningTop(map<string, float> _data, simple float _spinningTopBarMinWicks = 34, simple int _spinningTopBarEmaLength = 14) =>
    spread() > _data.get('SpreadLevelLow') and spread() < _data.get('SpreadLevelHigh') and volume() > _data.get('VolumeLevelLow') and volume() < _data.get('VolumeLevelHigh') and spinningTopBar(_spinningTopBarMinWicks, _spinningTopBarEmaLength)

// @function                        Determines if there is a neutral signal (Strong Spinning Top).
// @param _spinningTopBarMinWicks   (float) The minimum wicks percentage for spinning top bar. Default is 34 (represents 34%).
// @param _spinningTopBarEmaLength  (int) The length for EMA calculation. Default is 14.
